---
/**
 * Buchen-Dialog — Zwischenschritt zwischen "Fahrzeug buchen" und ELKATO.
 *
 * Titel:        ATG Carsharing — Buchen-Dialog
 * Version:      1.0
 * Autor:        Grundke IT-Service
 * Datum:        2026-08-30
 * Beschreibung: Die vier "Fahrzeug buchen"-Schaltflächen (Header, Mobilmenü,
 *               Schnellaktionen, Tab-Leiste) führten bisher auf den
 *               Mitgliederbereich der alten Seite. Sie zeigen jetzt direkt auf das
 *               ELKATO-Buchungsportal; davor legt sich dieser Dialog mit den
 *               Hinweisen, die im Mitgliederbereich stehen — vor allem der zur neuen
 *               Zugangskontrolle beim VAT, weil sonst jemand mit der falschen
 *               Transponderkarte vor einem Auto steht.
 *
 *               Inhalt wörtlich vom Verein übernommen (Stand 30.08.2026).
 *               sharePAD löst ELKATO später ab — dann nur ELKATO_URL und den
 *               Hinweistext tauschen, die Schaltflächen bleiben unberührt.
 *
 *               Ohne JavaScript führt der Link direkt zu ELKATO. Der Dialog ist eine
 *               Zutat, keine Voraussetzung.
 *
 * Änderungshistorie:
 *   2026-08-30  1.0  Erstausgabe (Anforderung Andreas, 30.08.2026).
 */
const base = import.meta.env.BASE_URL;
const ELKATO_URL = 'https://www.elkato.de/buchung/atg';
---

<dialog id="buchen-dialog" class="bd" aria-labelledby="bd-title">
  <div class="bd-inner">
    <button class="bd-x" type="button" data-buchen-close aria-label="Dialog schließen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>

    <h2 id="bd-title">Fahrzeug buchen</h2>
    <p class="bd-lead">Gebucht wird über <b>ELKATO</b>. Dort stehen die Fahrzeuge des ATG — und wenn du die Quernutzung vereinbart hast, auch die des Vaterstettener Auto-Teiler e.V.</p>

    <div class="bd-note">
      <b>Neue Zugangskontrolle beim VAT</b>
      <p>Die meisten Autos im VAT haben bereits eine neue Zugangskontrolle (Elektronik). Sie sind mit blauer Schrift und „ZKneu" gekennzeichnet und lassen sich mit den normalen Transponderkarten nicht öffnen. Bei Bedarf liegen bei Fam. Buxhoeveden (Winklerring 12, Tel. <a href="tel:+498932499000">089 32499000</a>) entsprechende neue Transponderkarten leihweise bereit.</p>
    </div>

    <a class="btn btn-yellow bd-go" href={ELKATO_URL} target="_blank" rel="noopener">
      Zur Buchung bei ELKATO
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><path d="M15 3h6v6" /><path d="M10 14 21 3" /></svg>
    </a>

    <ul class="bd-links">
      <li><a href="https://www.carsharing-vaterstetten.de/" target="_blank" rel="noopener">Standorte des VAT</a></li>
      <li><a href="https://www.atg-grasbrunn.de/dokumente-vat/" target="_blank" rel="noopener">VAT-Dokumentation</a></li>
    </ul>

    <p class="bd-fine">Die Zugangsdaten für ELKATO bekommst du nach der Aufnahme vom Vorstand. Noch kein Mitglied? <a href={`${base}#mitglied`} data-buchen-close>Hier geht es zur Anmeldung.</a></p>
  </div>
</dialog>

<style>
  .bd {
    width: min(560px, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    /* Der globale Reset setzt margin: 0 und nimmt dialog damit die eigene
       Zentrierung - deshalb hier ausdruecklich. */
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: #fff;
    color: var(--color-ink);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.65);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .bd::backdrop { background: rgba(28, 16, 14, 0.62); backdrop-filter: blur(2px); }
  .bd-inner { padding: 1.7rem clamp(1.1rem, 4vw, 1.9rem) 1.5rem; position: relative; }

  .bd-x {
    position: absolute; top: 0.7rem; right: 0.7rem;
    width: 38px; height: 38px; display: grid; place-items: center;
    border: 0; border-radius: 50%; background: var(--color-bg); color: var(--color-muted);
    cursor: pointer; transition: background 0.15s, color 0.15s;
  }
  .bd-x svg { width: 20px; height: 20px; }
  .bd-x:hover { background: var(--color-red-soft); color: var(--color-red-deep); }
  .bd-x:focus-visible { outline: 3px solid var(--color-yellow); outline-offset: 2px; }

  .bd h2 { font-size: 1.5rem; font-weight: 800; margin: 0 2.4rem 0.6rem 0; }
  .bd-lead { margin: 0 0 1.1rem; line-height: 1.5; }

  .bd-note {
    background: var(--color-bg);
    border-left: 4px solid var(--color-yellow);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    margin-bottom: 1.2rem;
  }
  .bd-note b { display: block; font-size: 0.95rem; margin-bottom: 0.25rem; }
  .bd-note p { margin: 0; font-size: 0.88rem; line-height: 1.5; color: var(--color-muted); }
  .bd-note a { color: var(--color-red-deep); font-weight: 700; }

  .bd-go { width: 100%; justify-content: center; gap: 0.55rem; }
  .bd-go svg { width: 18px; height: 18px; flex: none; }

  .bd-links { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  .bd-links a { font-size: 0.88rem; font-weight: 700; color: var(--color-red-deep); text-decoration: underline; }

  .bd-fine { margin: 1rem 0 0; font-size: 0.82rem; color: var(--color-muted); line-height: 1.5; }
  .bd-fine a { color: var(--color-red-deep); font-weight: 700; text-decoration: underline; }

  /* Auf kleinen Geräten füllt der Dialog den Schirm nahezu aus. */
  @media (max-width: 560px) {
    .bd { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; border-radius: 0; }
    .bd-inner { padding-top: 2.6rem; }
  }
</style>

<script>
  // Die Schaltflaechen verweisen im Markup direkt auf ELKATO. Hier wird der Klick
  // abgefangen und stattdessen der Dialog geoeffnet - ohne JavaScript bleibt der
  // direkte Weg bestehen. Modifier-Klicks (neuer Tab, neues Fenster) laufen durch.
  const dlg = document.getElementById('buchen-dialog') as HTMLDialogElement | null;

  if (dlg) {
    document.querySelectorAll<HTMLAnchorElement>('[data-buchen]').forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        dlg.showModal();
      });
    });

    // Klick auf den Hintergrund schliesst. Der Dialog selbst fuellt nicht die
    // ganze Flaeche, deshalb trifft ein Klick daneben das dialog-Element.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.querySelectorAll('[data-buchen-close]').forEach((el) => {
      el.addEventListener('click', () => dlg.close());
    });
  }
</script>
